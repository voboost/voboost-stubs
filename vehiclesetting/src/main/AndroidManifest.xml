<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_search"
        android:label="Vehicle Setting Stub"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name="com.qinggan.app.vehiclesetting.VehicleSettingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real settings-menu screen the settings-menu agent hooks
             (CarSettingActivity.onCreate); declared (not launcher) so
             `am start -n com.qinggan.app.vehiclesetting/.CarSettingActivity`
             works the same way it does on the real device. -->
        <activity
            android:name="com.qinggan.app.vehiclesetting.CarSettingActivity"
            android:exported="true" />

        <service
            android:name="com.qinggan.app.vehiclesetting.VehicleSettingService"
            android:exported="false" />

        <receiver
            android:name="com.qinggan.app.vehiclesetting.VehicleSettingBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
